# Configuración LOCAL del back. Copiar SIN editar a:
#   backend/src/main/resources/env.properties
# Spring la importa desde el classpath (application.properties:1: spring.config.import=optional:env.properties).
# Ojo: en backend/env.properties NO se lee. El archivo real está en .gitignore.
# Valores solo para desarrollo local, coherentes con docker-compose.yml. En producción, definir variables de entorno.

# Puerto HTTP del back
APP_PORT=8080
# Puerto de MySQL en localhost (servicio "db" de docker-compose.yml)
DB_PORT=3306
# Nombre de la base
DB_NAME=clonair
# Usuario de la base (local)
DB_USER=clonair
# Contraseña de la base (local, inventada)
DB_PASS=clonair_local_only

# Clave JWT SOLO local: Base64 de 32 bytes, generada con openssl rand -base64 32.
# En producción usar una clave propia como secreto del proveedor; nunca este valor público.
JWT_SECRET=yF6mYVMULz9vvbHwuDp+jwGm3dFffAdaT9Nd1zZLi/M=
# Duración del JWT en milisegundos (24 h; es también el default si se omite).
JWT_EXPIRATION=86400000

# Orígenes CORS exactos separados por comas, sin comodines (Vite y front de compose).
# Sin esta variable no se permiten solicitudes entre orígenes; en producción listar el front propio.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
